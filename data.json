  "news": [
    {
      "tag": "ABD · Şirket",
      "title": "Jensen Huang Nvidia CEO'luğundan istifa etti",
      "text": "Nvidia, Huang'ın istifasını duyurdu. CFO Colette Kress geçici CEO, Harvey C. Jones da şirketin ilk yönetim kurulu başkanı oldu. Hisse Perşembe günü sert düştü.",
      "why": "Nvidia tek başına S&P 500'ün yaklaşık %6'sı ve AI rallisinin lokomotifi. 17 Kasım'daki bilanço, Huang sonrası dönemin ilk sınavı olacak.",
      "source": "SEC / CNBC",
      "url": "https://www.sec.gov/Archives/edgar/data/0001045810/000104581026000082/nvidiaannouncesceotransiti.htm"
    },
    {
      "tag": "ABD · Fed",
      "title": "Piyasa artık Fed'den faiz indirimi değil artırım bekliyor",
      "text": "Ekim enflasyonu beklentiden yüksek geldi. Bir Fed yetkilisi de Aralık'ta yarım puanlık artış ihtimalini dile getirdi.",
      "why": "Faiz artışı hisse değerlemelerini (özellikle teknolojiyi) baskılar ve doları güçlendirir. Bu da gelişmekte olan piyasalara ve TL'ye yansır.",
      "source": "CNBC",
      "url": "https://www.cnbc.com/2026/11/09/stock-market-today-live-updates.html"
    },
    {
      "tag": "Emtia · Jeopolitik",
      "title": "İran gerginliği petrolü yeniden yukarı itti",
      "text": "Orta Doğu'daki çatışmanın seyrine dair belirsizlik Perşembe günü petrol fiyatlarını yükseltti.",
      "why": "Pahalı petrol enflasyonu besler, bu da Fed'in faiz artırma ihtimalini güçlendirir. Enerji ithalatçısı Türkiye için cari açık riski demek.",
      "source": "CNBC",
      "url": "https://www.cnbc.com/2026/11/11/stock-market-today-live-updates.html"
    },
    {
      "tag": "ABD · AI",
      "title": "AI hisselerinde lunapark haftası",
      "text": "Ara seçimler sonrası veri merkezi harcamalarının yavaşlayacağı korkusuyla Nasdaq düzeltme bölgesine girmişti. Bu hafta CoreWeave bilançosuyla toparlanma geldi.",
      "why": "Piyasa AI yatırımlarının sürdürülebilirliğini sorguluyor. Nvidia bilançosu bu tartışmanın yönünü belirleyebilir.",
      "source": "CNBC",
      "url": "https://www.cnbc.com/2026/11/10/stock-market-today-live-updates.html"
    },
    {
      "tag": "Türkiye",
      "title": "BIST 100 haftayı %3,14 yükselişle tamamladı",
      "text": "Endeks Cuma'yı %0,27 artışla 11.842,82'den kapattı. Hafta boyunca dolar/TL %0,42 yükselirken gram altın %3,53 değer kaybetti.",
      "why": "Küresel dalgalanmaya rağmen Borsa İstanbul pozitif ayrıştı. Analistler 12.000 ve 12.100 puanı direnç olarak izliyor.",
      "source": "Anadolu Ajansı",
      "url": "https://www.aa.com.tr/tr/ekonomi/borsa-gunu-yukselisle-tamamladi/4124427"
    }
