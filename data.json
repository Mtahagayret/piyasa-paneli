  "news": [
    {
      "tag": "ABD · Piyasa",
      "title": "Teknoloji satışı Nasdaq'ı %2,5 aşağı çekti",
      "text": "Pazartesi Nasdaq %2,49, S&P 500 %1,92, Dow Jones %1,41 düştü. Korku endeksi VIX %20'ye yakın sıçrayarak 23'ün üzerine çıktı; Alphabet ve Amazon da %3 civarında geriledi.",
      "why": "VIX'teki sert yükseliş yatırımcıların tedirgin olduğunu gösterir. Bu hafta Nvidia bilançosu ve Anthropic halka arzı gibi büyük olaylar olduğu için dalgalanma sürebilir.",
      "source": "Yahoo Finance",
      "url": "https://finance.yahoo.com/markets/live/stock-market-today-monday-november-16-dow-sp-500-nasdaq-nvidia-oil-091631084.html"
    },
    {
      "tag": "ABD · Şirket",
      "title": "Nvidia bilanço öncesi %4 değer kaybetti",
      "text": "Yönetim kurulunun Jensen Huang'ı geri getirmeyi düşünmediğinin duyulmasıyla Nvidia %4,1 düşüşle 156 doların altına indi; hisse son beş günde yaklaşık %13 kaybetmişti. Şirket 3. çeyrek sonuçlarını Salı akşamı (TR saatiyle Çarşamba gece) açıklayacak.",
      "why": "Nvidia, yapay zekâ rallisinin en büyük hissesi. Bilanço beklentinin altında kalırsa ya da yönetim belirsizliği sürerse tüm teknoloji sektörü etkilenebilir.",
      "source": "Yahoo Finance",
      "url": "https://finance.yahoo.com/markets/live/stock-market-today-monday-november-16-dow-sp-500-nasdaq-nvidia-oil-091631084.html"
    },
    {
      "tag": "ABD · Halka arz",
      "title": "Anthropic Perşembe günü Nasdaq'ta işlem görmeye başlıyor",
      "text": "Anthropic, 'ANT' koduyla 19 Kasım'da Nasdaq'ta işlem görmeye başlayacak. Hisse başına 70-78 dolar aralığından 64 milyar dolara kadar kaynak toplaması ve aralığın tepesinde yaklaşık 1,4 trilyon dolarlık değerleme hedefleniyor.",
      "why": "Tarihin en büyük halka arzı olabilir. Analistler bu kadar büyük bir arzın, yatırımcı parasını diğer yapay zekâ hisselerinden çekebileceği uyarısında bulunuyor.",
      "source": "The Next Web",
      "url": "https://thenextweb.com/news/anthropic-ipo-terms-1-4-trillion-valuation"
    },
    {
      "tag": "Emtia · Petrol",
      "title": "Brent petrol %4 düşüşle 92 doların altına indi",
      "text": "Hürmüz Boğazı'ndan geçen sevkiyatların toparlanması petrol fiyatlarını aşağı çekti; bölgeye üçüncü bir ABD uçak gemisinin ulaşması bile düşüşü durdurmadı.",
      "why": "Türkiye enerjisinin büyük kısmını ithal ediyor. Petroldeki düşüş cari açık ve enflasyon için olumlu, ama TÜPRAŞ gibi rafineri hisselerinin marjlarını etkileyebilir.",
      "source": "Yahoo Finance",
      "url": "https://finance.yahoo.com/markets/live/stock-market-today-monday-november-16-dow-sp-500-nasdaq-nvidia-oil-091631084.html"
    },
    {
      "tag": "Emtia · Altın",
      "title": "Ons altın son bir yılın en düşük seviyelerinde",
      "text": "Ons altın günü %0,8 civarı düşüşle 3.857 dolar dolaylarında kapattı, gün içinde 3.835 dolara kadar geriledi. Gram altın 6.275 TL civarında yatay seyretti.",
      "why": "ABD'de 10 yıllık tahvil faizinin %5'in üzerinde kalması, faiz getirmeyen altını daha az cazip kılıyor. Dolar/TL'nin yükselişi gram altındaki düşüşü sınırlıyor.",
      "source": "BloombergHT",
      "url": "https://www.bloomberght.com/piyasalarda-gunun-ozeti-16-kasim-2026-bist-100-de-degisimler-ve-doviz-fiyatlari-pkh-3794783"
    },
    {
      "tag": "Türkiye · Borsa",
      "title": "BIST 100 yatay kapandı, FTSE Russell Türkiye'nin statüsünü korudu",
      "text": "BIST 100 günü %0,01'lik düşüşle 11.841,81 puandan tamamladı, bankacılık endeksi %0,6 geriledi. FTSE Russell, Türkiye'yi izleme listesine almadı ve 'Gelişmiş Gelişen Piyasa' statüsünü korudu.",
      "why": "Endeks sağlayıcılarının sınıflandırması, yabancı fonların Türkiye'ye ne kadar para ayıracağını etkiler. Analistler 12.000-12.100 bölgesini direnç olarak izliyor.",
      "source": "CNBC-e",
      "url": "https://www.cnbce.com/borsa/borsa-gunu-dususle-kapadi-16-kasim-2026-h41884"
    }
  ],
