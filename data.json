  "news": [
    {
      "tag": "ABD · Piyasa",
      "title": "Teknoloji satışı Nasdaq'ı haftanın son gününde aşağı çekti",
      "text": "Cuma günü Nasdaq yaklaşık %0,9, S&P 500 %0,4 geriledi; Dow Jones ise savunmacı hisselerin desteğiyle hafif artıda kapandı. AMD gibi çip hisseleri sert düşerken 10 yıllık ABD tahvil faizi %5'in üzerine tırmandı.",
      "why": "Tahvil faizi yükseldiğinde gelecekteki kârların bugünkü değeri düşer; bu da en çok büyüme beklentisiyle fiyatlanan teknoloji hisselerini vurur. %5 eşiği piyasa için psikolojik bir sınır.",
      "source": "The Motley Fool",
      "url": "https://www.fool.com/coverage/stock-market-today/2026/11/13/stock-market-midday-nov-13-nasdaq-plunges-as-nvidia-turmoil-deepens-and-treasury-yields-hit-5/"
    },
    {
      "tag": "ABD · Şirket",
      "title": "Jensen Huang Nvidia CEO'luğundan istifa etti",
      "text": "Nvidia, Huang'ın istifasını duyurdu. CFO Colette Kress geçici CEO, Harvey C. Jones da şirketin ilk yönetim kurulu başkanı oldu. Hisse Perşembe günü sert düştü.",
      "why": "Nvidia tek başına S&P 500'ün yaklaşık %6'sı ve AI rallisinin lokomotifi. 17 Kasım'daki bilanço, Huang sonrası dönemin ilk sınavı olacak.",
      "source": "SEC / CNBC",
      "url": "https://www.sec.gov/Archives/edgar/data/0001045810/000104581026000082/nvidiaannouncesceotransiti.htm"
    },
    {
      "tag": "Türkiye · Makro",
      "title": "Cari denge Eylül'de 2,72 milyar dolar fazla verdi",
      "text": "TCMB verilerine göre Türkiye Eylül'de cari fazla verdi; altın ve enerji hariç tutulduğunda fazla 7,3 milyar doları aştı. Fazla Ağustos'taki 4,05 milyar dolara göre daraldı.",
      "why": "Cari fazla, ülkeye giren dövizin çıkandan fazla olduğu anlamına gelir; bu da TL üzerindeki baskıyı hafifletir. Petrol pahalanırsa bu tablo hızla bozulabilir.",
      "source": "CNBC-e",
      "url": "https://www.cnbce.com/veriler/merkez-bankasi-acikladi-eylulde-272-milyar-dolar-cari-fazla-verildi-h41723"
    },
    {
      "tag": "ABD · Fed",
      "title": "Piyasa artık Fed'den faiz indirimi değil artırım bekliyor",
      "text": "Ekim enflasyonu beklentiden yüksek geldi. Bir Fed yetkilisi de Aralık'ta yarım puanlık artış ihtimalini dile getirdi.",
      "why": "Faiz artışı hisse değerlemelerini (özellikle teknolojiyi) baskılar ve doları güçlendirir. Bu da gelişmekte olan piyasalara ve TL'ye yansır.",
      "source": "CNBC",
      "url": "https://www.cnbc.com/2026/11/09/stock-market-today-live-updates.html"
    },
    {
      "tag": "Türkiye",
      "title": "BIST 100 haftayı %3,14 yükselişle tamamladı",
      "text": "Endeks Cuma'yı %0,27 artışla 11.842,82'den kapattı. Hizmetler endeksi %1,26 ile öne çıkarken Astor %7,56 ile günün en çok düşenlerindendi.",
      "why": "ABD'deki teknoloji dalgalanmasına rağmen Borsa İstanbul pozitif ayrıştı. 12.000 puan, yakından izlenen bir direnç seviyesi.",
      "source": "Anadolu Ajansı / Canlı Gaste",
      "url": "https://www.canligaste.com/piyasalarda-gun-sonu-13-kasim-2026/949208/"
    },
    {
      "tag": "Emtia",
      "title": "Altın haftayı sert kayıpla kapattı, petrol 96 doların üzerinde",
      "text": "Ons altın Cuma'yı 3.880 dolar civarında tamamladı ve haftalık bazda %5'in üzerinde değer kaybetti. Brent petrol ise İran kaynaklı gerginlikle 96 doların üzerinde kaldı.",
      "why": "Yükselen faiz beklentisi faiz getirmeyen altını cazibesiz kılıyor. Pahalı petrol ise hem enflasyonu hem de enerji ithal eden Türkiye'nin dış dengesini zorluyor.",
      "source": "PR Newswire / Canlı Gaste",
      "url": "https://www.prnewswire.com/news-releases/weekly-gains-hold-up-despite-a-friday-slide-as-chips-lead-and-yields-climb-302939329.html"
    }
  ],
